APP_NAME=csv-job-platform
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/csv_job_platform
